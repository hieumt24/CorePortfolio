{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KBS": {
    "BaseUrl": "https://kbbuddywts.kbsec.com.vn/iis-server/investment/",
    "TimeoutSeconds": 20,
    "LookbackDays": 14,
    "PriceCacheSeconds": 300,
    "InstrumentCacheHours": 6
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://core-portfolio-taupe.vercel.app"
    ]
  },
  "MarketPrices": {
    "Enabled": true,
    "CryptoRefreshIntervalSeconds": 7200,
    "StockRefreshIntervalSeconds": 1800,
    "FundRefreshIntervalSeconds": 21600
  },
  "Fmarket": {
    "BaseUrl": "https://api.fmarket.vn/",
    "TimeoutSeconds": 20,
    "FundCacheMinutes": 60
  },
  "Backups": {
    "RetentionCount": 10,
    "ListLimit": 30
  },
  "CoinGecko": {
    "CacheSeconds": 300,
    "UniverseSize": 100,
    "UniverseCacheMinutes": 60
  },
  "UserActivity": {
    "OnlineWindowMinutes": 5,
    "WriteIntervalSeconds": 60
  },
  "Security": {
    "TwoFactor": {
      "EnforceForPrivilegedRoles": false,
      "EncryptionKey": "",
      "Issuer": "CorePortfolio",
      "ChallengeLifetimeMinutes": 5,
      "MaxVerificationAttempts": 5,
      "AllowedTimeStepDrift": 1,
      "RecoveryCodeCount": 10
    }
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "TrustAllProxies": false
  },
  "AllowedHosts": "*"
}
